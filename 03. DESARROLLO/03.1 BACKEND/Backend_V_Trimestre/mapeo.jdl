application {
config {
    baseName datastock
    applicationType monolith
    packageName com.mycompany.datastock
    authenticationType jwt
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider no
    buildTool maven
    clientFramework react
    enableTranslation false
    nativeLanguage es
    languages [es]
    websocket no
    testFrameworks [cucumber]
   
    //entitySuffix false
    jhiPrefix project
    reactive false
    serverPort 8080
    searchEngine no
    clientTheme cyborg
    clientThemeVariant primary
    dtoSuffix DTO
    skipClient false
    skipServer false
 

   
}
    entities  *
   
}

/* ===================== ENUMS ===================== */

enum Estado {
  ACTIVO,
  INACTIVO
}

enum EstadoOperacion {
  PENDIENTE,
  ACEPTADA,
  RECHAZADA
}

/* ===================== ACTORES ===================== */

entity TipoDocumento {
  tipoDocumento String required unique maxlength(30)
}

entity Cuenta {
  numeroDocumento      String required maxlength(10)
  primerNombre         String required maxlength(20)
  segundoNombre        String maxlength(20)
  primerApellido       String required maxlength(20)
  segundoApellido      String maxlength(20)
  numeroCelular        String required maxlength(20)
  eps                  String required maxlength(30)
  contactoEmergencia   String required maxlength(20)
  parentezcoEmergencia String required maxlength(20)
  nombreEmergencia     String required maxlength(20)
}

/* ===================== ERROR ===================== */

entity HistorialError {
  nombreError String required maxlength(150)
  mensaje     String required maxlength(255)
  fechaHora   Instant required
}

/* ===================== LUGAR ===================== */

entity Sitio {
  nombre String required maxlength(70) unique
}

/* ===================== MERCANCIA ===================== */

entity Marca {
  marca       String required maxlength(50) unique
  estadoMarca Estado required
}

entity Categoria {
  nombre          String required maxlength(100) unique
  estadoCategoria Estado required
}

entity Presentacion {
  tipoPresentacion String required maxlength(50) unique
}

entity Producto {
  nombreEspecificacion String required maxlength(200) unique
  estadoDisponibilidad Estado required
}

entity Lote {
  fechaIngreso      LocalDate required
  fechaVencimiento  LocalDate required
  codigoLote        String required maxlength(100)
  descripcion       String maxlength(10)
  facturaProveedor  String required maxlength(255)
  cantidadIngresada Integer required min(0)
}

entity EstadoProducto {
  tipoEstado String required maxlength(50) unique
}

entity ProductoSitio {
  cantidadSitio Integer required min(0)
}

/** Detalle del traslado: lote/producto/cantidad que se mueve de un sitio a otro */
entity TrasladoProductoSitio {
  cantidadTraslado Integer required min(0)
}

/* ===================== LOGISTICA ===================== */

entity CuentaSitio

/** Cabecera de la remisión: los datos comunes se guardan una sola vez */
entity Codigo {
  fechaRemision   LocalDate required
  codigo          String required maxlength(255)
  estadoOperacion EstadoOperacion required
}

entity Remision {
  cantidadRemitida Integer required min(0)
}

entity Traslado {
  descripcion String maxlength(150)
}

entity MotivoSalida {
  tipoMotivo String required maxlength(150) unique
}

/** Solo para el empleado que únicamente sube el archivo de excel */
entity EvidenciaSalida {
  archivoExcel String required maxlength(255)
  nombreExcel  String required maxlength(255)
  fechaCarga   LocalDate required
}

/** Para el Administrador que SOLO completa la salida de inventario */
entity Salida {
  respaldoImagen String maxlength(255)
  cantidadASacar Integer required min(1)
  observaciones  String maxlength(150)
}

/* ===================== RELACIONES ===================== */

relationship OneToOne {
  Cuenta{user(login) required} to User with builtInEntity
  Salida{evidenciaSalida required} to EvidenciaSalida{salida}
}

relationship ManyToOne {
  /* actores */
  Cuenta{tipoDocumento(tipoDocumento) required} to TipoDocumento{cuentas}
  HistorialError{cuenta(numeroDocumento)required} to Cuenta{historialErrores}

  /* mercancia */
  Producto{categoria(nombre) required} to Categoria{productos}
  Producto{presentacion(tipoPresentacion) required} to Presentacion{productos}
  Producto{marca(marca) required} to Marca{productos}
  Lote{producto(nombreEspecificacion) required} to Producto{lotes}

  ProductoSitio{producto(nombreEspecificacion) required} to Producto{productoSitios}
  ProductoSitio{sitio(nombre) required} to Sitio{productoSitios}
  ProductoSitio{lote(codigoLote) required} to Lote{productoSitios}
  ProductoSitio{estadoProducto(tipoEstado) required} to EstadoProducto{productoSitios}

  TrasladoProductoSitio{traslado required} to Traslado{trasladoProductoSitios}
  TrasladoProductoSitio{productoSitio required} to ProductoSitio{trasladoProductoSitios}

  /* logistica */
  CuentaSitio{cuenta(numeroDocumento) required} to Cuenta{cuentaSitios}
  CuentaSitio{sitio(nombre) required} to Sitio{cuentaSitios}

  Codigo{cuentaSitio required} to CuentaSitio{codigos}

  Remision{productoSitio(id_producto) required} to ProductoSitio{remisiones}
  Remision{codigo(EstadoOperacion) required} to Codigo{remisiones}
  Remision{sitioDestino(nombre) required} to Sitio{remisionesDestino}

  Traslado{cuentaSitio required} to CuentaSitio{traslados}
  Traslado{sitioDestino(nombre) required} to Sitio{trasladosDestino}
  Traslado{codigo required} to Codigo{traslados}

  EvidenciaSalida{cuenta(numeroDocumento) required} to Cuenta{evidenciaSalidas}
  EvidenciaSalida{sitioSubida(nombre) required} to Sitio{evidenciaSalidas}

  Salida{cuentaSitio required} to CuentaSitio{salidas}
  Salida{motivoSalida(tipoMotivo) required} to MotivoSalida{salidas}
  
}

/* Tabla intermedia producto_sitio__salida */
relationship ManyToMany {
  Salida{productoSitios required} to ProductoSitio{salidas}
}

// fin de mis entidades
dto * with mapstruct
service * with serviceImpl
paginate * with pagination
//search * with elasticsearch